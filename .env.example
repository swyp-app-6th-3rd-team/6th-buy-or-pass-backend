# 이 파일을 .env 로 복사한 뒤 값을 채운다.
#   cp .env.example .env
# .env 는 .gitignore 에 있다. 절대 커밋하지 않는다.

# ── 컨테이너 ────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=sakila
TZ=Asia/Seoul

# ── MySQL ──────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=sakila
MYSQL_USER=sakila
MYSQL_PASSWORD=change-me-app
MYSQL_PORT=3306

# ── 애플리케이션 ────────────────────────────────────────────
APP_PORT=8080
# local  = Sakila 시드 데이터(9MB) 로드 + SQL 로그 + 콘솔·파일 로깅
# prod   = 마이그레이션만 + 콘솔·파일 로깅
SPRING_PROFILES_ACTIVE=local

# ── 로그 ────────────────────────────────────────────────────
# 로그는 error/warn/info 디렉터리로 나뉘어 도커 볼륨(sakila-log)에 쌓인다.
# 컨테이너를 삭제해도 남는다. 확인 방법은 README 의 "로그 확인" 참조.
LOG_MAX_HISTORY=30
LOG_TOTAL_SIZE_CAP=3GB

# ── JWT ────────────────────────────────────────────────────
# HS256 이므로 최소 256비트(32바이트) 이상이어야 한다.
# 기동 시 길이를 검증하며, 짧으면 애플리케이션이 뜨지 않는다.
# 생성: openssl rand -base64 48
JWT_SECRET_KEY=

# ── OAuth2 ─────────────────────────────────────────────────
# 쓰지 않는 프로바이더는 비워두면 해당 로그인만 비활성화된다.
# Google:  https://console.cloud.google.com/apis/credentials
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# Kakao:   https://developers.kakao.com/console/app
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
# Naver:   https://developers.naver.com/apps
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=

# ── 관측성 (OpenTelemetry, 옵트인) ─────────────────────────
# 기본은 꺼져 있다. 아래 값들은 에이전트를 붙일 때만 쓰인다.
#
#   # 최초 1회 — 백엔드는 여러 앱이 공유하는 독립 스택이다
#   docker network create observability-net
#   docker compose -f observability/docker-compose.yml up -d
#
#   # 앱에 에이전트 부착
#   docker compose -f docker-compose-prod.yml -f docker-compose-otel.yml --profile app up -d

# OTel Java Agent 버전. 아키텍처 독립적인 단일 jar 라 arm64/amd64 를 가리지 않는다.
OTEL_AGENT_VERSION=2.30.0

# ServerMap 의 노드 이름. 같은 앱을 여러 대 띄우면 이 값은 동일해야 한다.
OTEL_SERVICE_NAME=sakila-ddd-template

# 앱이 collector 를 찾는 주소.
#   컨테이너로 띄울 때  → http://otel-collector:4318 (같은 external 네트워크)
#   IDE 로 띄울 때      → http://localhost:4318
OTEL_ENDPOINT=http://otel-collector:4318

# 샘플링. 낮추면 Tempo service graph 의 엣지 카운트가 과소 집계된다
# (Pinpoint 는 에이전트 측에서 세므로 샘플링과 무관하게 정확했다).
# 단일 홈서버에서는 전수 수집이 현실적이다.
OTEL_SAMPLER=parentbased_always_on
TRACE_SAMPLE_RATE=1.0

DEPLOY_ENV=prod

# 관리 포트 — /actuator/prometheus 가 여기 열린다.
# 서비스 포트(8080)와 분리해 메트릭이 외부에 공개되지 않게 한다.
MANAGEMENT_PORT=9090

# ── Grafana / 백엔드 ───────────────────────────────────────
GRAFANA_PORT=3000
GRAFANA_USER=admin
# ⚠ 홈서버에 올리기 전에 반드시 바꾼다: openssl rand -base64 24
GRAFANA_PASSWORD=admin
# 익명 열람. 기본값 false. 로컬에서 빠르게 훑어볼 때만 true 로 둔다.
# 홈서버 배포 하드닝: docs/observability-deployment.md
GRAFANA_ANONYMOUS=false

# collector 수신 포트(호스트 노출용 — IDE 기동 시 필요)
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# Prometheus 보존 기간
PROM_RETENTION=15d
